# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# Workers
NEXT_PUBLIC_API_URL=https://aidevhub-api.your-subdomain.workers.dev

# D1 Database (via Workers)
D1_DATABASE_ID=your_d1_database_id

# R2 Storage
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key

# Public
NEXT_PUBLIC_SITE_URL=https://aidevhub.net
NEXT_PUBLIC_SITE_NAME=AI Dev Hub
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Analytics (optional)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your_cf_analytics_token
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XW0J813JL9

# AI Content Generation (optional - used by generate-tool.ts and generate-blog.ts --ai flag)
OPENAI_API_KEY=your_openai_api_key
